{
  "singleQuote": true,
  "sortImports": true,
  "ignorePatterns": [
    "**/dist",
    "coverage",
    "pnpm-lock.yaml",
    "extension/manifest.json",
    // Copied from the repo root into server/ by the prepack script; not source.
    "server/README.md",
    "server/LICENSE",
    // Generated example pages (notes-tree renders); not hand-edited source.
    "docs/examples/",
  ],
}
